# ============================================================
# REQUIRED
# ============================================================

# Comma-separated GitHub Personal Access Tokens.
# Each token gives 5,000 requests/hour. Round-robin across all.
# Fine-grained PATs need: Metadata: read + Contents: read.
GITHUB_TOKENS=ghp_replace_me_1,ghp_replace_me_2

# ============================================================
# LIMITS
# ============================================================

MAX_CLIENTS=8
MAX_QUEUE=512
MAX_CONCURRENT_FETCHES=12
MAX_FILE_SIZE=8388608
STREAM_CHUNK_SIZE=524288
TRUNCATE_PREVIEW_BYTES=262144

# ============================================================
# CONNECTION LIFECYCLE
# ============================================================

IDLE_TIMEOUT_SECONDS=3600
PING_INTERVAL_SECONDS=45

# ============================================================
# SERVER
# ============================================================

PORT=8080
ALLOWED_ORIGINS=*
LOG_LEVEL=debug
